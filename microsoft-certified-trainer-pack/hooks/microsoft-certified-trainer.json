{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/pre-trainer-session.sh",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/scripts/pre-trainer-session.ps1"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/post-trainer-session.sh",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/scripts/post-trainer-session.ps1"
      }
    ]
  }
}
