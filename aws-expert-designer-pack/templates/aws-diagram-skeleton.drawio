<mxfile host="drawio" compressed="false">
  <!--
    AWS diagram skeleton: title block, external actor, decorative Region frame, VPC with two
    Availability Zones and public and private subnets, auxiliary services frame, step badge and legend.

    Conventions this skeleton encodes:
    * Region is decorative (container=0). Its contents are parented to cell 1, not to the frame.
    * VPC, Availability Zone and subnet are real containers (container=1); children move with them.
    * Colors: VPC #8C4FFF, public subnet #248814, private subnet #147EBA, Region #00A4A6; text matches stroke.
    * Fonts: Helvetica; title 30 bold, subtitle 16, group 14 bold, container 12 bold, service 10, edge 11.
    * A public subnet is public because of its route table; say so in the label, not only by color.

    Adding a service: create a 120x120 category container (container=1) inside the right subnet, with a
    48x48 child whose style is shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.NAME, where NAME is
    taken from the installed AWS4 library. Put the AWS product name in the icon label and the category
    in the container label. Attach edges to the icon cell, never to the container. Use stable semantic IDs.
    Remove the second Availability Zone or the auxiliary frame when the design does not have them.
  -->
  <diagram id="aws-skeleton" name="Overview">
    <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Workload name: AWS architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Scope, audience, source of truth and date" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="1000" height="28" as="geometry" />
        </mxCell>
        <mxCell id="actor_external" value="External users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;fontColor=#232F3E;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=bottom;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="140" height="120" as="geometry" />
        </mxCell>
        <mxCell id="badge_1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#00A4A6;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="150" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="region_primary" value="AWS Region" style="rounded=0;whiteSpace=wrap;html=1;container=0;fillColor=none;strokeColor=#00A4A6;fontColor=#00A4A6;fontFamily=Helvetica;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="240" y="140" width="1060" height="900" as="geometry" />
        </mxCell>
        <mxCell id="vpc_main" value="VPC (CIDR)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=none;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontFamily=Helvetica;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="190" width="1000" height="620" as="geometry" />
        </mxCell>
        <mxCell id="az_a" value="Availability Zone a" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;dashed=1;fillColor=none;strokeColor=#147EBA;fontColor=#147EBA;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="vpc_main">
          <mxGeometry x="20" y="40" width="470" height="560" as="geometry" />
        </mxCell>
        <mxCell id="subnet_public_a" value="Public subnet a (route table sends 0.0.0.0/0 to the internet gateway)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F2F6E8;strokeColor=#248814;fontColor=#248814;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="az_a">
          <mxGeometry x="20" y="40" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="subnet_private_a" value="Private subnet a (no route to the internet gateway)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#147EBA;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="az_a">
          <mxGeometry x="20" y="290" width="430" height="250" as="geometry" />
        </mxCell>
        <mxCell id="az_b" value="Availability Zone b" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;dashed=1;fillColor=none;strokeColor=#147EBA;fontColor=#147EBA;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="vpc_main">
          <mxGeometry x="510" y="40" width="470" height="560" as="geometry" />
        </mxCell>
        <mxCell id="subnet_public_b" value="Public subnet b (route table sends 0.0.0.0/0 to the internet gateway)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F2F6E8;strokeColor=#248814;fontColor=#248814;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="az_b">
          <mxGeometry x="20" y="40" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="subnet_private_b" value="Private subnet b (no route to the internet gateway)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F2F8;strokeColor=#147EBA;fontColor=#147EBA;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="az_b">
          <mxGeometry x="20" y="290" width="430" height="250" as="geometry" />
        </mxCell>
        <mxCell id="aux_services" value="Auxiliary services (not primary flow steps)" style="rounded=0;whiteSpace=wrap;html=1;container=0;dashed=1;fillColor=none;strokeColor=#879196;fontColor=#545B64;fontFamily=Helvetica;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="840" width="1000" height="170" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Teal badge: primary flow step&lt;br&gt;Solid arrow: synchronous request&lt;br&gt;Dashed arrow: asynchronous message or replication (labeled)&lt;br&gt;Edge label starting cross-AZ, cross-Region, hybrid or egress: cost-bearing path&lt;br&gt;Teal frame: AWS Region (decorative)&lt;br&gt;Purple frame: VPC&lt;br&gt;Dashed blue frame: Availability Zone&lt;br&gt;Green frame: public subnet&lt;br&gt;Blue frame: private subnet&lt;br&gt;Dashed grey frame: auxiliary services" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;rounded=0;fillColor=#FFFFFF;strokeColor=#545B64;fontColor=#232F3E;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1330" y="140" width="290" height="300" as="geometry" />
        </mxCell>
        <mxCell id="note_evidence" value="Evidence labels (observed, inferred, designed, unresolved) for every element and edge are in the companion report." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="1330" y="460" width="290" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
