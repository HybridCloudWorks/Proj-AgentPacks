{
  "description": "Local lifecycle audit and workflow completion guard for the Codex Agentic Orchestrator.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/codex_event.py --event SessionStart",
            "statusMessage": "Recording orchestration session start"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/codex_event.py --event SubagentStart",
            "statusMessage": "Recording Codex subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/codex_event.py --event SubagentStop",
            "statusMessage": "Recording Codex subagent result"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/codex_event.py --event Stop",
            "statusMessage": "Checking orchestration completion",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
