+    def test_claude_native_frontmatter_is_preserved(self, temp_project):
+        from apm_cli.utils.diagnostics import DiagnosticCollector
+
+        source = temp_project / "source" / "native.prompt.md"
+        source.write_text(
+            """---
+description: Native Claude command
+when_to_use: Only when the user requests a review
+arguments: [issue, focus]
+disable-model-invocation: true
+user-invocable: false
+disallowed-tools: [Bash]
+effort: high
+context: fork
+agent: general-purpose
+background: false
+shell: powershell
+metadata:
+  owner: platform
+license: Apache-2.0
+compatibility: Claude Code
+name: not-a-command-name
+paths: ["**/*.py"]
+author: package-author
+---
+Review the requested issue.
+""",
+            encoding="utf-8",
+        )
+        target = temp_project / ".claude" / "commands" / "native-apm.md"
+        mock_info = MagicMock()
+        mock_info.package.name = "native-pkg"
+        mock_info.resolved_reference = None
+        diagnostics = DiagnosticCollector()
+
+        CommandIntegrator().integrate_command(
+            source,
+            target,
+            mock_info,
+            source,
+            diagnostics=diagnostics,
+        )
+
+        metadata = frontmatter.load(target).metadata
+        for key, value in {
+            "description": "Native Claude command",
+            "when_to_use": "Only when the user requests a review",
+            "arguments": ["issue", "focus"],
+            "disable-model-invocation": True,
+            "user-invocable": False,
+            "disallowed-tools": ["Bash"],
+            "effort": "high",
+            "context": "fork",
+            "agent": "general-purpose",
+            "background": False,
+            "shell": "powershell",
+            "metadata": {"owner": "platform"},
+            "license": "Apache-2.0",
+            "compatibility": "Claude Code",
+        }.items():
+            assert metadata[key] == value
+
+        assert "name" not in metadata
+        assert "paths" not in metadata
+        warnings = diagnostics.by_category().get("warning", [])
+        assert any(
+            "author" in item.message and "name" in item.message and "paths" in item.message
+            for item in warnings
+        )
+        info_items = diagnostics.by_category().get("info", [])
+        assert not any("Mapped input" in item.message for item in info_items)
+
