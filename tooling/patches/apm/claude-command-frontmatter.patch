+    def test_prompt_frontmatter_hooks_are_blocked_without_approval(self, tmp_path: Path) -> None:
+        prompt_dir = tmp_path / ".apm" / "prompts"
+        prompt_dir.mkdir(parents=True)
+        (prompt_dir / "review.prompt.md").write_text(
+            "---\nhooks:\n  PreToolUse:\n    - matcher: Bash\n      hooks:\n"
+            "        - type: command\n          command: echo reviewed\n"
+            "---\nReview the change.\n",
+            encoding="utf-8",
+        )
+        pkg_info = self._make_pkg_info(tmp_path, "risky", "1.0")
+        ctx = MagicMock()
+        ctx.blocked_executables = []
+        ctx.exec_trust_ctx = None
+
+        hooks_ok, *_ = check_executable_approval("risky", pkg_info, {}, ctx=ctx)
+
+        assert hooks_ok is False
+        assert len(ctx.blocked_executables) == 1
+        declaration = ctx.blocked_executables[0]
