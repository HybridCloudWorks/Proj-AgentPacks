diff --git a/src/apm_cli/security/executables.py b/src/apm_cli/security/executables.py
index 768709b..58e8826 100644
--- a/src/apm_cli/security/executables.py
+++ b/src/apm_cli/security/executables.py
@@ -25,6 +25,8 @@ from dataclasses import dataclass, field
 from pathlib import Path
 from typing import Any
 
+import yaml
+
 # Executable type constants used as keys in the allowExecutables block.
 EXEC_TYPE_HOOKS = "hooks"
 EXEC_TYPE_MCP = "mcp"
@@ -530,6 +532,8 @@ def scan_package_executables(
     Checks for:
     - ``.apm/hooks/*.json`` and ``hooks/*.json`` -- hook definitions
       (mirrors :meth:`HookIntegrator.find_hook_files`)
+    - ``*.prompt.md`` and ``.apm/prompts/*.prompt.md`` with non-empty
+      Claude ``hooks`` frontmatter
     - ``bin/`` directory -- bin executables
     - MCP and LSP are declared in the package's ``apm.yml`` under
       ``dependencies.mcp`` and ``dependencies.lsp`` -- so we parse those.
@@ -551,6 +555,28 @@ def scan_package_executables(
             )
     hook_details = [f.name for f in hook_files]
 
+    # Claude command hooks are executable too, so they participate in the
+    # same package-level hook approval as JSON hook files.
+    from ..utils.path_security import has_symlink_component
+    from ..utils.yaml_io import load_frontmatter
+
+    source_root = install_path.resolve()
+    command_hook_details: list[str] = []
+    for prompt_root in (source_root, source_root / ".apm" / "prompts"):
+        if has_symlink_component(source_root, prompt_root) or not prompt_root.is_dir():
+            continue
+        for prompt_file in sorted(prompt_root.glob("*.prompt.md")):
+            if has_symlink_component(source_root, prompt_file) or not prompt_file.is_file():
+                continue
+            try:
+                metadata = load_frontmatter(prompt_file).metadata
+            except (OSError, ValueError, yaml.YAMLError):
+                continue
+            if isinstance(metadata, dict) and metadata.get("hooks"):
+                relative_path = prompt_file.relative_to(source_root).as_posix()
+                command_hook_details.append(f"{relative_path} (Claude command frontmatter hooks)")
+    hook_details.extend(command_hook_details)
+
     # 2. Bin executables: top-level bin/ AND .apm/skills/*/bin/
     bin_files: list[Path] = []
     for bin_dir in [install_path / "bin"]:
@@ -621,7 +647,7 @@ def scan_package_executables(
         package_name=package_name,
         is_transitive=is_transitive,
         parent_name=parent_name,
-        hook_count=len(hook_files),
+        hook_count=len(hook_files) + len(command_hook_details),
         mcp_count=mcp_count,
         lsp_count=lsp_count,
         bin_count=len(bin_files),
